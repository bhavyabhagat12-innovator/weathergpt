# Environment configuration for WeatherGPT
APP_NAME=WeatherGPT
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Database Configuration (PostgreSQL / SQLite dual-mode)
# In local dev without Docker, fallback to SQLite: sqlite+aiosqlite:///./weathergpt.db
DATABASE_URL=sqlite+aiosqlite:///./weathergpt.db
# For production PostgreSQL / PostGIS:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/weathergpt

# MongoDB Configuration (for raw bulletins / unstructured feeds)
MONGODB_URL=mongodb://localhost:27017/weathergpt
USE_LOCAL_BULLETIN_STORE=True

# LLM Providers (pluggable: gemini, openai, ollama)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Weather Data Providers & Rate Limits
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com/v1
HISTORICAL_METEO_BASE_URL=https://archive-api.open-meteo.com/v1
IMD_BULLETIN_FEED_URL=https://mausam.imd.gov.in/responsive/all_india_bulletin.php
GDACS_FEED_URL=https://www.gdacs.org/xml/rss.xml

# Voice / TTS Settings
TTS_ENGINE=browser
STT_ENGINE=browser
